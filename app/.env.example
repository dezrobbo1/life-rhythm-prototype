# Required-mode public frontend configuration only. No secrets or bearer tokens.
VITE_LIFE_RHYTHM_MODE=required
VITE_LIFE_RHYTHM_AUTH_ENABLED=true
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only opt-in; default off. Requires exact Vercel Preview/project identity.
# Do not enable without separate reviewed Preview configuration/run approval.
LIFE_RHYTHM_ALLOW_VERCEL_PREVIEW_SELF_ORIGIN=false
